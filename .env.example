# GEFIN Agent - Environment variables
# Copy to .env and adjust as needed

# --- LLM ---
# Provider: anthropic | openai | ollama
# Recommended for quality: anthropic (Claude)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Anthropic / Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI-compatible (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Ollama local (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://ollama:11434
# LLM_MODEL=qwen2.5:14b

# --- Database ---
DATABASE_URL=postgresql://gefin:gefin@db:5432/gefin
# Em produção (Neon): postgresql://user:pass@host/db?sslmode=require&channel_binding=require

# --- App environment ---
# development liga o --reload do Uvicorn (usado pelo docker-compose local).
# Deixe vazio/ausente em produção (Render).
APP_ENV=development

# Usado só para exibir a origem correta na linhagem (get_lineage). Deixe
# ausente localmente ("local" é o default); em produção (Render) é setado
# como "production" via render.yaml.
DEPLOYMENT_ENV=local

# --- Catalog ---
CATALOG_PATH=/app/catalog/metrics.yaml

# --- Agent ---
MAX_AGENT_STEPS=6
SQL_ROW_LIMIT=500
SQL_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
